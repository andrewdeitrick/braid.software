---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import ProblemStatement from "../components/ProblemStatement.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Relays from "../components/Relays.astro";
import Features from "../components/Features.astro";
import BuiltForSolo from "../components/BuiltForSolo.astro";
import Roadmap from "../components/Roadmap.astro";
import Testimonials from "../components/Testimonials.astro";
import Pricing from "../components/Pricing.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
---

