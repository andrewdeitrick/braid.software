>
  <Nav />
  <main>
    <Hero />
    <Testimonials />
    <ProblemStatement />
    <HowItWorks />
    <Relays />
    <Features />
    <BuiltForSolo />
    <Roadmap />
    <Pricing />
    <FAQ />
    <FinalCTA />
  </main>
  <Footer />
</Layout>
