---
import { BRAID_PRO_CHECKOUT_URL } from "../lib/links";
---

<nav id="nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" id="nav-brand" class="flex items-center gap-3 opacity-0 -translate-y-2 transition-all duration-300 pointer-events-none">
      <img src="/braid-logo.png" alt="Braid" class="w-10 h-10 rounded-lg" />
      <span class="text-xl font-bold tracking-[0.15em] uppercase">BR<span class="bg-gradient-to-r from-accent-green to-accent-blue bg-clip-text text-transparent">AI</span>D</span>
    </a>
    <div class="hidden sm:flex items-center gap-8">
      <a href="#relays" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Relays</a>
      <a href="#features" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Features</a>
      <a href="#roadmap" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Roadmap</a>
      <a href="#pricing" class="text-sm text-text-secondary hover:text-text-primary transition-colors">Pricing</a>
      <a href={BRAID_PRO_CHECKOUT_URL} class="inline-flex items-center px-4 py-2 rounded-lg bg-accent-green text-bg-base text-sm font-semibold hover:brightness-110 transition">Get Braid Pro</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById("nav");
  const navBrand = document.getElementById("nav-brand");
  const heroBrand = document.getElementById("hero-brand");

  const observer = new IntersectionObserver(
    ([entry]) => {
      const scrolledPast = !entry.isIntersecting;

      if (scrolledPast) {
        nav.classList.add("bg-bg-surface/95", "backdrop-blur-md", "border-b", "border-border-default");
        navBrand.classList.remove("opacity-0", "-translate-y-2", "pointer-events-none");
        navBrand.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
      } else {
        nav.classList.remove("bg-bg-surface/95", "backdrop-blur-md", "border-b", "border-border-default");
        navBrand.classList.add("opacity-0", "-translate-y-2", "pointer-events-none");
        navBrand.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
      }
    },
    { threshold: 0, rootMargin: "-64px 0px 0px 0px" }
  );

  if (heroBrand) observer.observe(heroBrand);
</script>
