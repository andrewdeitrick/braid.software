---
import { BRAID_DOWNLOAD_URL, BRAID_PRO_CHECKOUT_URL } from "../lib/links";
---

<section class="relative pt-32 pb-20 px-6 overflow-hidden">
  <!-- Brand braid backdrop -->
  <img
    src="/braid-bg-top-to-bottom.png"
    alt=""
    aria-hidden="true"
    class="absolute top-0 left-1/2 -translate-x-1/2 w-[1100px] max-w-none opacity-30 pointer-events-none select-none"
    style="mask-image: radial-gradient(ellipse 60% 70% at 50% 35%, black 40%, transparent 80%); -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 35%, black 40%, transparent 80%);"
  />
  <!-- Background glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[600px] rounded-full bg-accent-purple/10 blur-[120px] pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/3 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] rounded-full bg-accent-green/8 blur-[100px] pointer-events-none"></div>

  <div class="relative max-w-4xl mx-auto text-center">
    <div id="hero-brand" class="flex items-center justify-center gap-5 mb-8">
      <img src="/braid-logo.png" alt="Braid" class="w-40 h-40 rounded-3xl shadow-lg shadow-accent-purple/20" />
      <span class="text-[8rem] sm:text-[9rem] font-bold tracking-[0.15em] leading-none uppercase">BR<span class="bg-gradient-to-r from-accent-green to-accent-blue bg-clip-text text-transparent">AI</span>D</span>
    </div>

    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-normal tracking-tight leading-[1.1]">
      Your parallel agents,<br />
      <span class="bg-gradient-to-r from-accent-purple via-accent-blue to-accent-green bg-clip-text text-transparent">now on autopilot.</span>
    </h1>

    <p class="mt-6 text-lg sm:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed">
      Run Claude, Codex, and your shell side by side in isolated git worktrees — or hand a task to a relay and let it implement, review, open the PR, and fix CI until it's green. You decide how much it does on its own.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={BRAID_PRO_CHECKOUT_URL} class="inline-flex items-center px-8 py-3.5 rounded-xl bg-accent-green text-bg-base font-semibold text-base hover:brightness-110 transition shadow-lg shadow-accent-green/20">
        Get Braid Pro — $50/yr
      </a>
      <a href={BRAID_DOWNLOAD_URL} class="inline-flex items-center px-6 py-3 rounded-xl border border-border-default text-text-primary text-sm font-medium hover:bg-bg-surface transition">
        Try free with 1 project
      </a>
    </div>

    <p class="mt-6 text-text-muted text-xs sm:text-sm">
      Mac · Local-first · Your code never leaves your machine
    </p>
  </div>

  <!-- App screenshot -->
  <div class="relative mt-20 max-w-5xl mx-auto">
    <div class="absolute inset-0 bg-gradient-to-t from-bg-base via-transparent to-transparent z-10 pointer-events-none"></div>
    <div class="rounded-xl overflow-hidden border border-border-default shadow-2xl shadow-accent-purple/10">
      <img
        src="/braid-app.png"
        alt="Braid running a full-auto relay — Claude implements, Codex reviews, the PR opens, CI goes red then green — across parallel tasks in isolated git worktrees"
        class="w-full"
        loading="eager"
      />
    </div>
  </div>
</section>
